                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25555"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25555"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A biogeochemical cycle which has nitrogen-bearing chemical entities as participants.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>nitrogen cycle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">nitrogen cycling</rdfs:label>
    </owl:Class>
    


