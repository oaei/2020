        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>This class, from the IPCC report, is naturally focused on the Earth&apos;s climate. The report cites the Sun as the agent of the most important forcing processes. It also considers the direct effect of human activities on the climate system an external forcing</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://www.ipcc.ch/ipccreports/tar/wg1/040.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


