            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mining process during which materials are extracted from the surface, or below the surface, of the ocean floor.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-4366-3088</oboInOwl:created_by>
