        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Food_truck</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000972 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000972">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000934"/>
        <obo:IAO_0000115>A restaurant which provides prepared meals or other food products that the purchaser must eat off its premises.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>take out restaurant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>take-away</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">take-out restaurant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000972"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
