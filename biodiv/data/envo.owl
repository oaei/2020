        </rdfs:subClassOf>
        <obo:IAO_0000115>A biogeochemical cycle which has phosphorous-bearing chemical entities as participants.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>sulphur cycling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>phosphorous cycle</oboInOwl:hasRelatedSynonym>
