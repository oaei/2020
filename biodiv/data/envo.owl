    <!-- http://purl.obolibrary.org/obo/ENVO_01001190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001190">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
