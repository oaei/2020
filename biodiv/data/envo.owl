        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TGN:23451</oboInOwl:hasDbXref>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">channel of a watercourse</rdfs:label>
