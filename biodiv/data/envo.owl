    <!-- http://purl.obolibrary.org/obo/ENVO_01001446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001436"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000744"/>
