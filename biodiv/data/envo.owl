        <obo:IAO_0000115>A mining process during which metal ores and minerals that lie near the terrestrial surface of an astronomical body are extracted by removing the overlying material and breaking and loading the ore.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym>openpit mining</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>strip mining</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">opencast mining</rdfs:label>
    </owl:Class>
    <owl:Axiom>
