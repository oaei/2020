    <!-- http://purl.obolibrary.org/obo/ENVO_01000392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000435"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000204"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000345"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A montane forest which is located in a region subject to tropical climate patterns modulated by sufficient elevation to encounter upper montane climate patterns.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class is one of the forest types as identified by the updated Global Forest Map (GFM 2000).</rdfs:comment>
        <rdfs:label>tropical upper montane forest</rdfs:label>
    </owl:Class>
    


