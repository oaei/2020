            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portion of carbon nanotube enriched soil is a portion of soil with elevated levels of carbon nanotubes.</obo:IAO_0000115>
