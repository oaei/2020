        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sediment comprised of weathered continental rocks, wind blown dust, volcanic ash or other terrestrial material.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ORCID:0000-0002-4366-3088</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000071 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000258"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000015"/>
