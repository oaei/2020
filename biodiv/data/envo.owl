                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000133"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any water ice that is part of a glacier.</obo:IAO_0000115>
        <obo:IAO_0000116>It is suggested that users complement this term with ice terms that are more descriptive of the ice itself, rather than its location/parthood.</obo:IAO_0000116>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <obo:IAO_0000117>http://orcid.org/0000-0002-4366-3088</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">glacial ice</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any water ice that is part of a glacier.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Glacier</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000025"/>
        <rdfs:subClassOf>
