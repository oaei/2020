    <!-- http://purl.obolibrary.org/obo/ENVO_01000964 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002001"/>
        <obo:IAO_0000115>Wastewater which is produced by industrial activity and which contains chemical contaminants other than those associated with urine and fecal matter.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">industrial wastewater</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000965 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000070"/>
        <obo:IAO_0000115>A construction which is designed to hold water in which humans may swim or perform other leisure activities.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>pool</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>paddling pool</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>swimming bath</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>swimming pool</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>wading pool</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">constructed swimming pool</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000965"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A construction which is designed to hold water in which humans may swim or perform other leisure activities.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Swimming_pool</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000966 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000966">
