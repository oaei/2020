            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A lake which has concentrations of environmental contaminants high enough to harm the ecosystems associated with it.</obo:IAO_0000115>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">polluted lake</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000681 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000681">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000508"/>
