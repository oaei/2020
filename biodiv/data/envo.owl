        <obo:IAO_0000115>A slum is a heavily populated urban informal settlement with substandard housing in which households lack any one of the following: access to improved water, access to improved sanitation, sufficient-living area, durability of housing, or security of tenure.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">slum</rdfs:label>
    </owl:Class>
