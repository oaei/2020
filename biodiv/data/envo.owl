                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001322"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A layer of estuarine water which constitutes the pycnocline from a fiat boundary where the estuary bed below the water column reaches a depth of 4 meters until the end of the estuary most distal from the coast.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CMECS:601</oboInOwl:hasAlternativeId>
