    <!-- http://purl.obolibrary.org/obo/ENVO_01000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000024"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The marine bathyal zone biome comprises regions of the marine benthic biome between approximately 200 m and 3000 m depth. This zone generally coincides with the continental slope.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ORCID:0000-0002-4366-3088</oboInOwl:created_by>
