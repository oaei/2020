            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A monitoring process that assays the level of environmental pollutants to determine the presence of effect of environmental pollution.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>pollution monitoring</rdfs:label>
    </owl:Class>
    


