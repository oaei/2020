    <!-- http://purl.obolibrary.org/obo/ENVO_01001528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000814"/>
