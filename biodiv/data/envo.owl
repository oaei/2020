            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Frost heaving is a process during which an upwards swelling of soil occurs due to freezing conditions caused by an increasing presence of ice as it grows towards the surface.</obo:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0003-1264-1166"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-04T20:17:35Z</dc:date>
        <oboInOwl:inSubset>envoNceas</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">frost heaving process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_04000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Frost heaving is a process during which an upwards swelling of soil occurs due to freezing conditions caused by an increasing presence of ice as it grows towards the surface.</owl:annotatedTarget>
