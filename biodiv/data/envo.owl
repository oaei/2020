        </rdfs:subClassOf>
        <obo:IAO_0000115>A water temperature which inheres in water close to the surface of an ocean or sea.</obo:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0003-1264-1166"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-03-06T00:50:17Z</dc:date>
        <oboInOwl:hasExactSynonym>ocean surface temperature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sea surface temperature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>temperature of the ocean surface</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset>envoMarine</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoNceas</oboInOwl:inSubset>
        <rdfs:comment>The exact meaning of surface varies according to the measurement method used, but it is between 1 millimetre (0.04 in) and 20 metres (70 ft) below the sea surface.</rdfs:comment>
        <rdfs:label xml:lang="en">temperature of sea surface</rdfs:label>
    </owl:Class>
