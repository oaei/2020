                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001733"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An evergreen needleleaf forest which is subject to temperate climate patterns.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coniferous forest</oboInOwl:hasBroadSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class is one of the forest types as identified by the updated Global Forest Map (GFM 2000).</rdfs:comment>
        <rdfs:label>temperate evergreen needleleaf forest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000384">
