        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tannery</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003323"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A tannery is a building in which the skins of animals are treated with chemicals to alter the structure of their constituent proteins, creating leather.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Tannery</oboInOwl:hasDbXref>
    </owl:Axiom>
    


