    <!-- http://purl.obolibrary.org/obo/ENVO_01001078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001081"/>
        <obo:IAO_0000115>Environmental variability which inheres in an astronomical body part or in outer space.</obo:IAO_0000115>
        <rdfs:comment>This class refers to all weather, including atmospheric and space weather. Please use a subclass for more specificity.</rdfs:comment>
        <rdfs:label xml:lang="en">weather</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Environmental variability which inheres in an astronomical body part or in outer space.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Space_weather</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Weather</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001079">
