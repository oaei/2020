        <obo:IAO_0000115>A sea ice formation process during which seawater freezes onto first year ice during the cold season, forming second year sea ice.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <obo:IAO_0000117>http://orcid.org/0000-0002-4366-3088</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment>Second year ice forms from first year ice which has previously survived one melt season.</rdfs:comment>
        <rdfs:label xml:lang="en">second year ice formation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sea ice formation process during which seawater freezes onto first year ice during the cold season, forming second year sea ice.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Sea_ice#New_ice.2C_nilas_and_young_ice</oboInOwl:hasDbXref>
    </owl:Axiom>
    


