        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
        <obo:IAO_0000115>A wax is an environmental material which is primarily composed of lipids or other organic compounds that consist of long alkyl chains. Waxes are are malleable near ambient temperatures and melt at approximately 45 degrees Celsius.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">wax</rdfs:label>
    </owl:Class>
