            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The site which is located in a crater.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">crater zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001356 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001356">
