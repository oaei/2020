    <!-- http://purl.obolibrary.org/obo/ENVO_01000579 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <obo:IAO_0000115>A television set is a device that combines a tuner, display, and loudspeakers for the purpose of converting digital or analog information signals into moving images and sound.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>television</oboInOwl:hasBroadSynonym>
