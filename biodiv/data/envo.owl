        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Island</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_1000750 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_1000750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000098"/>
