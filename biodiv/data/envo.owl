                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An environmental zone in which the rates of two or more processes are roughly equal to one another.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">environmental zone of processual equilibrium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001354 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000133"/>
