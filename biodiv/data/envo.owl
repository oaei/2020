    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000019"/>
