            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sintering process during which snow is compacted into glacial ice.</obo:IAO_0000115>
        <obo:IAO_0000116>Axioms will probably need to be updated if the axiomatisation of solid-phase sintering changes.</obo:IAO_0000116>
        <obo:IAO_0000117></obo:IAO_0000117>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <obo:IAO_0000117>http://orcid.org/0000-0002-4366-3088</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">glacial sintering</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000102"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sintering process during which snow is compacted into glacial ice.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Sintering</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03000103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000103">
