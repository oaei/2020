        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A freshwater lake which fills a depression formed by the erosion of thermokarst caused by permafrost thaw.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Thermokarst</oboInOwl:hasDbXref>
    </owl:Axiom>
    


