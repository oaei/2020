    <!-- http://purl.obolibrary.org/obo/ENVO_00001998 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00001998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
