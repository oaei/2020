    <!-- http://purl.obolibrary.org/obo/ENVO_00002047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000022"/>
