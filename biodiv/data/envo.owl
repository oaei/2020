    <!-- http://purl.obolibrary.org/obo/ENVO_00000546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002007"/>
