                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000386"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Frozen soil which is firmly cemented by water ice, is subject to brittle failure, and exhibits practically no consolidation under load.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-14T21:23:25Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">hard-frozen soil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001525"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
