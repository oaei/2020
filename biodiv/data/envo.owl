    <!-- http://purl.obolibrary.org/obo/ENVO_01001514 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001515"/>
        <obo:IAO_0000115>Freshwater ice which forms downward from the surface of a freshwater water body and is transparent due to a reduced number of air bubbles trapped in its mass.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-4366-3088</oboInOwl:created_by>
