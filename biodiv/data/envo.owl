            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A surface layer of a water body which has been formed as the result of surface ice fracturing and moving apart.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-27T19:26:14Z</oboInOwl:creation_date>
