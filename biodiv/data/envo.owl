    <!-- http://purl.obolibrary.org/obo/ENVO_01001258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000844"/>
