    <!-- http://purl.obolibrary.org/obo/ENVO_01000580 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
        <obo:IAO_0000115>A telephone is a telecommunications device which converts sound into electronic signals suitable for transmission via cables or other transmission media, and reconverts such signals into sound waves.</obo:IAO_0000115>
