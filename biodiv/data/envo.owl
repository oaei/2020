                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000293"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A process during which a part of a glacier breaks away from the main mass as an iceberg.</obo:IAO_0000115>
        <obo:IAO_0000116>It would be ideal to express that the size of the icemass calved must be smaller than an iceberg.</obo:IAO_0000116>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <obo:IAO_0000117>http://orcid.org/0000-0002-4366-3088</obo:IAO_0000117>
