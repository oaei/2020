        <obo:IAO_0000115>A landslide is a process whereby a large mass of earth and rocks moves down a hill or a mountainside.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GEMET:http://www.eionet.europa.eu/gemet/concept/4668</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>landslip</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">landslide process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000692"/>
