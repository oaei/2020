        <obo:IAO_0000115>Establishment of a new forest by seeding or planting of nonforested land.</obo:IAO_0000115>
        <rdfs:comment>Prior to afforestation, the land cover of a region must not include forests.</rdfs:comment>
        <rdfs:label>afforestation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Establishment of a new forest by seeding or planting of nonforested land.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GEMET:http://www.eionet.europa.eu/gemet/concept/167</oboInOwl:hasDbXref>
    </owl:Axiom>
    


