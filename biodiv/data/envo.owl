            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A land fire which occurs in a large uncleared or sparsely settled area (as in Australia) usually scrub-covered or forested.</obo:IAO_0000115>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <rdfs:comment>&quot;Bush&quot; is a rather loosely defined regional term, primarily used in Australia.</rdfs:comment>
        <rdfs:label xml:lang="en">bush fire</rdfs:label>
    </owl:Class>
    


