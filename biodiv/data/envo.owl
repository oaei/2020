        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A swamp which is located in tropical or subtropical environments and is determined by communities of trees and shrubs growing saline coastal environments.</obo:IAO_0000115>
