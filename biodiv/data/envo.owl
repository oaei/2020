            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An atmosphere which surrounds a planet.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">planetary atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000811 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000811">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000810"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_15379"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_17997"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A planetary atmosphere which is composted primarily of dinitrogen and dioxygen gas.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment>An instance of this class would be Earth&apos;s atmosphere.</rdfs:comment>
        <rdfs:label xml:lang="en">nitrogen-oxygen planetary atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000812 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000812">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001311"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
