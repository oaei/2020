        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/P%C3%A1ramo</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001360"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Paramo ecosystems are known to be evolutionary hotspots and large daily fluctuations in temperature and humidity, often resulting in dialy freez-thaw cycles.</owl:annotatedTarget>
