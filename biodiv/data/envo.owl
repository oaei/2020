        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A speleothem hanging downwards from a roof or wall, of cylindrical or conical form, usually with a central hollow tube.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://wasg.iinet.net.au/terminol.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000332 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000332">
