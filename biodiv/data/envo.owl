    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000581 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000580"/>
        <obo:IAO_0000115>A mobile phone is a telephone which transmits sound information to a mobile phone network via radio transmissions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cell phone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cellular phone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hand phone</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">mobile phone</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000581"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mobile phone is a telephone which transmits sound information to a mobile phone network via radio transmissions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Telephone</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000582 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000580"/>
        <obo:IAO_0000115>A landline telephone is a telephone which is connected to a telephone network with wires through which electronic signals are carried.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">landline telephone</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000582"/>
