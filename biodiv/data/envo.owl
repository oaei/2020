    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001365">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001368"/>
