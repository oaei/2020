            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A fire which occurs on land, typically consuming a terrestrial ecosystem as fuel.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">land fire</rdfs:label>
    </owl:Class>
    


