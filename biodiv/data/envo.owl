        <oboInOwl:hasExactSynonym>dry-frozen soil</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">friable-frozen soil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001528"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
