        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A subsidence process is a geomorphologic process in which a surface shifts downward relative to a datum such as sea-level.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Subsidence</oboInOwl:hasDbXref>
    </owl:Axiom>
    


