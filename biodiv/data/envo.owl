        <oboInOwl:hasRelatedSynonym>tundra</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>tundra</rdfs:label>
    </owl:Class>
