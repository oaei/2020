        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000572"/>
        <obo:IAO_0000115>A battery-powered electric lamp is an electric lamp which draws its power from a device composed of two or more electrochemical cells that convert stored chemical energy into electrical energy.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">battery-powered electric lamp</rdfs:label>
