                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A desert surface covered with closely packed, interlocking angular or rounded rock fragments of pebble and cobble size.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>gibber</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reg</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>saï</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>serir</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">desert pavement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000812"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A desert surface covered with closely packed, interlocking angular or rounded rock fragments of pebble and cobble size.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Desert_pavement</oboInOwl:hasDbXref>
    </owl:Axiom>
    


