        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">seafloor feature</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ADL:FTT</oboInOwl:hasDbXref>
    </owl:Axiom>
