            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An ice loss process which occurs in the low-altitude area of a glacier or ice sheet below the firn layer.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <obo:IAO_0000117>http://orcid.org/0000-0002-4366-3088</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">glacial ice ablation process</rdfs:label>
    </owl:Class>
