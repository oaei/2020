        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000197"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lake from which there is no outflow of water, either on the surface as rivers, or underground by flow or diffusion through rock or permeable material.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Endorheic</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000488"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lake permanently covered by ice.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Subglacial_lake</oboInOwl:hasDbXref>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
