        <oboInOwl:hasRelatedSynonym>glaze ice</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">glaze ice layer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A glaze ice layer is a smooth, transparent and homogeneous ice layer which coats some surface and which is formed when freezing rain or drizzle hits that surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Glaze_ice</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
