            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A system which is composed of carbon-based chemical entities dissolved in or otherwise part of an ocean or sea and the atmosphere adjacent to it, undergoing constant exchange through biogeochemical cycling.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-11T00:03:08Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>carbonate system of the sea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>marine carbonate system</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset>envoEOVs</oboInOwl:inSubset>
        <oboInOwl:inSubset>envoMarine</oboInOwl:inSubset>
        <rdfs:comment>To measure the state and dynamics of the ocean&apos;s carbonate system, at least two of the following qualities must be measured: Dissolved Inorganic Carbon (DIC), Total Alkalinity (TA), Partial pressure of carbon dioxide (pCO2), and pH.</rdfs:comment>
        <rdfs:label xml:lang="en">carbonate system of ocean water</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001498 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000086"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <rdfs:subClassOf>
            <owl:Restriction>
