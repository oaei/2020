                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000508"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000000"/>
