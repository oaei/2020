            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Dioxygen which is the solute in a solution with ocean water as its solvent.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-4366-3088</oboInOwl:created_by>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-10T15:49:02Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>dissolved oxygen</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>oceanic oxygen</oboInOwl:hasBroadSynonym>
