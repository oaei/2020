                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A rocky slope is a slope which has a surface primarily composed of rock.</obo:IAO_0000115>
        <rdfs:label>rocky slope</rdfs:label>
    </owl:Class>
    


