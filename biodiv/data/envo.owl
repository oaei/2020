                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_15379"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_16526"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_17997"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000266"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A flame which is produced by the combustion of hydrocarbon fuel.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">hydrocarbon flame</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000791 -->

