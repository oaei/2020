            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A broadleaf forest biome which is subject to subtropical climate patterns.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ORCID:0000-0002-4366-3088</oboInOwl:created_by>
