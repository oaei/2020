                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500036"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A planned process during which the amount of pollutants released into an environmental system is regulated.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>pollution prevention</oboInOwl:hasNarrowSynonym>
        <rdfs:label>pollution control</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02500043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02500043">
