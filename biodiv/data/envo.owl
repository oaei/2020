        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">marine chemocline</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
