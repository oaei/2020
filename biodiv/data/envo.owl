    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000077"/>
        <obo:IAO_0000115>A physical space, which may or may not be in a construction, which is used to store animal feed for agricultural purposes.</obo:IAO_0000115>
        <obo:IAO_0000116>This should be moved to &quot;zone&quot;, and inference should be used to link to agricultural feature.</obo:IAO_0000116>
