        <obo:IAO_0000115>A subsidence process is a geomorphologic process in which a surface shifts downward relative to a datum such as sea-level.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>subsidence</oboInOwl:hasBroadSynonym>
        <oboInOwl:inSubset>environmental_hazards</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">geological subsidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
