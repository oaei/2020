        <rdfs:label xml:lang="en">hydrogel</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001562"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A gel which is primarily composed of a network of polymer chains that are hydrophilic, sometimes found as a colloidal gel in which water is the dispersion medium.</owl:annotatedTarget>
        <rdfs:comment>https://en.wikipedia.org/wiki/Gel#Hydrogels</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
