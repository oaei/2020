                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Glacial ice which contains material liberated during a glacial erosion process.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <obo:IAO_0000117>http://orcid.org/0000-0002-4366-3088</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">erosionally enriched glacial ice</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Glacial ice which contains material liberated during a glacial erosion process.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://www.asf.alaska.edu/blog/why-is-glacier-ice-blue/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_03000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500028"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
