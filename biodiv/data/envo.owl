                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000799"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An astronomical object which is composed of dense gas and dust rotating around a young newly formed star, a T Tauri star, or a Herbig Ae/Be star in a disk-shaped configuration.</obo:IAO_0000115>
        <oboInOwl:inSubset>envoAstro</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">protoplanetary disk</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001150"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An astronomical object which is composed of dense gas and dust rotating around a young newly formed star, a T Tauri star, or a Herbig Ae/Be star in a disk-shaped configuration.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Protoplanetary_disk</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001151">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
