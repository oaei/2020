    <!-- http://purl.obolibrary.org/obo/ENVO_00000133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
