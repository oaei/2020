    <!-- http://purl.obolibrary.org/obo/ENVO_00000223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002000"/>
