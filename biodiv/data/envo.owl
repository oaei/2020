                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00010483"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/envo#has_increased_levels_of"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26710"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A haline environment is an environment in which entities are exposed to high concentrations of salt, typically above 2 molar.</obo:IAO_0000115>
        <rdfs:label>haline environment</rdfs:label>
    </owl:Class>
    


