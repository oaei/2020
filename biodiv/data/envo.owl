        <obo:IAO_0000115>The removal of forest and undergrowth to, for example, increase the surface of arable land or to use the timber for construction or industrial purposes.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>clearance</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>clearing</oboInOwl:hasBroadSynonym>
        <rdfs:label>deforestation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The removal of forest and undergrowth to, for example, increase the surface of arable land or to use the timber for construction or industrial purposes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://www.eionet.europa.eu/gemet/concept?cp=2036</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02500013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02500013">
