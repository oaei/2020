    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000066"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000591"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
