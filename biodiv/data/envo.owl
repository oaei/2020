        <oboInOwl:hasRelatedSynonym>A liquid planetary surface which is composed primarily of water.</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This includes the surface layers of all volumes of water exposed to space or the planet&apos;s atmosphere.</rdfs:comment>
        <rdfs:label xml:lang="en">water-based planetary surface</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001193"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>A liquid planetary surface which is composed primarily of water.</owl:annotatedTarget>
