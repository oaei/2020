            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An environmental system determined by seawater.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ocean water environment</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:label>sea water environment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000322">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000307"/>
                    <owl:Restriction>
