            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The planting of trees in areas in where forests have previously been cleared.</obo:IAO_0000115>
        <rdfs:comment>reforestation is reestablishment of forest where the forest recently existed[IPCC]</rdfs:comment>
        <rdfs:label>reforestation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The planting of trees in areas in where forests have previously been cleared.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Adapted from GEMET:http://www.eionet.europa.eu/gemet/concept/6979</oboInOwl:hasDbXref>
    </owl:Axiom>
    


