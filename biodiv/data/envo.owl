        <oboInOwl:hasExactSynonym>black ice</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">congelation ice in a fresh water body</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001514"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Freshwater ice which forms downward from the surface of a freshwater water body and is transparent due to a reduced number of air bubbles trapped in its mass.</owl:annotatedTarget>
