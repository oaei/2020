    <!-- http://purl.obolibrary.org/obo/ENVO_00010622 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00010622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00003074"/>
