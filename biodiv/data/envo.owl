    <!-- http://purl.obolibrary.org/obo/ENVO_00000216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000667"/>
