    <!-- http://purl.obolibrary.org/obo/ENVO_01001468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000230"/>
