        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002200"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000952"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Sea ice which has a brown colouration, either due to 1) the presence of pigments which are or were contained in the members of ecological assemblages, such as algal communities, living or trapped within the ice or 2) due to the presence of trapped sediments.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>brownish colored sea ice</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">brown sea ice</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001190"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Sea ice which has a brown colouration, either due to 1) the presence of pigments which are or were contained in the members of ecological assemblages, such as algal communities, living or trapped within the ice or 2) due to the presence of trapped sediments.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://dx.doi.org/10.1016/j.csr.2017.04.010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://dx.doi.org/10.1038/nrmicro3522</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://dx.doi.org/10.1371/journal.pone.0122418</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://github.com/EnvironmentOntology/envo/issues/564</oboInOwl:hasDbXref>
    </owl:Axiom>
    


