                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000027"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01000028"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
