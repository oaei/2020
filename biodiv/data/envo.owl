        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wood</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Getty:TGN</oboInOwl:hasDbXref>
    </owl:Axiom>
    


