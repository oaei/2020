    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_1000749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000221"/>
        <obo:IAO_0000115>An island created when a continent is rifted.</obo:IAO_0000115>
        <rdfs:comment>&quot;Examples are Madagascar and Socotra off Africa, the Kerguelen Islands, New Caledonia, New Zealand, and some of the Seychelles.&quot; https://en.wikipedia.org/wiki/Island</rdfs:comment>
