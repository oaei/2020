        <obo:IAO_0000115>A composting toilet fixture is a dry toilet fixture in which managed, aerobic decomposition converts human excreta into organic matter suitable for the fertilisation or amendment of soils.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">composting toilet</rdfs:label>
    </owl:Class>
