                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A process during which the mass of one or more materials, present within a given site, increases.</obo:IAO_0000115>
        <obo:IAO_0000117>http://orcid.org/0000-0002-3410-4655</obo:IAO_0000117>
        <obo:IAO_0000117>http://orcid.org/0000-0002-4366-3088</obo:IAO_0000117>
        <oboInOwl:inSubset>envoPolar</oboInOwl:inSubset>
        <rdfs:comment>Experimental class for structural purposes not recommended for annotation. A material accumulation process ends a material transport process.</rdfs:comment>
        <rdfs:label xml:lang="en">material accumulation process</rdfs:label>
    </owl:Class>
    


