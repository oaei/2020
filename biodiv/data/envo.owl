        </rdfs:subClassOf>
        <obo:IAO_0000115>The site which is located in a volcanic crater.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">volcanic crater zone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000191"/>
