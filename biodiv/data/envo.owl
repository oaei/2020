    <!-- http://purl.obolibrary.org/obo/ENVO_00002264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00002264">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00010483"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
