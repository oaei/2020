            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A landform which has been rendered barren or partially barren by environmental extremes, especially by low rainfall.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">desert</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001082"/>
