 <skos:broader rdf:resource='http://opendata.inra.fr/anaeeThes/c2_2527'/>
 <skos:definition xml:lang='en'>	
% or g Kg-1</skos:definition>
 <skos:definition xml:lang='en'>a loose earthy extremely fine grained natural sediment or soft rock composed primarily of clay size or colloidal particles and characterized by high plasticity and by a considerable content of clay mineral and subordinate amounts of finely divided quartz decomposed feldspar carbonates ferruginous matter and other impurities it forms a plastic moldable mass when finely ground and mixed with water retains its shape on drying and becomes firm rocklike and permanently hard on heating or firing</skos:definition>
 <skos:exactMatch rdf:resource='http://aims.fao.org/aos/agrovoc/c_15619'/>
 <skos:exactMatch rdf:resource='http://www.eionet.europa.eu/gemet/concept/1449'/>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>clay</skos:prefLabel>
 <skos:prefLabel xml:lang='fr'>argile</skos:prefLabel>
</rdf:Description>

