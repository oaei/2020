<rdf:Description rdf:about='http://opendata.inra.fr/anaeeThes/c2_2322'>
 <status:hasStatus rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>Published</status:hasStatus>
 <rdf:type rdf:resource='http://www.w3.org/2004/02/skos/core#Concept'/>
 <skos:altLabel xml:lang='en'>Si</skos:altLabel>
 <skos:broader rdf:resource='http://opendata.inra.fr/anaeeThes/c2_2308'/>
 <skos:definition xml:lang='en'>a brittle metalloid element that exists in two allotropic forms occurs principally in sand quartz granite feldspar and clay it is usually a grey crystalline solid but is also found as a brown amorphous powder it is used in transistors rectifiers solar cells and alloys its compounds are widely used in glass manufacture the building industry and in the form of silicones</skos:definition>
 <skos:exactMatch rdf:resource='http://aims.fao.org/aos/agrovoc/c_7061'/>
 <skos:exactMatch rdf:resource='http://www.eionet.europa.eu/gemet/concept/7694'/>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>Silicon</skos:prefLabel>
 <skos:prefLabel xml:lang='fr'>Silicium</skos:prefLabel>
</rdf:Description>

