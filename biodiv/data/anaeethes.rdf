 <skos:broader rdf:resource='http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#CompositeUnit'/>
 <skos:definition xml:lang='en'>The newton is the unit of force derived in the SI system; it is equal to the amount of net force required to accelerate a mass of one kilogram at a rate of one meter per second per second. 1 N = kg  m  s-2</skos:definition>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>newton</skos:prefLabel>
