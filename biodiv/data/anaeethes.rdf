 <rdf:type rdf:resource='http://www.w3.org/2004/02/skos/core#Concept'/>
 <skos:broader rdf:resource='http://opendata.inra.fr/anaeeThes/c2_2445'/>
 <skos:definition xml:lang='en'>The waters of the Earth, as distinguished from the rocks (lithosphere), living things (biosphere), and the air (atmosphere). Includes the waters of the ocean; rivers, lakes, and other bodies of surface water in liquid form on the continents; snow, ice, and glaciers; and liquid water, ice, and water vapour in both the unsaturated and saturated zones below the land surface. Included by some, but excluded by others, is water in the atmosphere , which includes water vapour, clouds, and all forms of precipitation while still in the atmosphere. (Source: BJGEO)</skos:definition>
 <skos:exactMatch rdf:resource='http://www.eionet.europa.eu/gemet/concept/4124'/>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>hydrosphere</skos:prefLabel>
 <skos:prefLabel xml:lang='fr'>hydrosph&#232;re</skos:prefLabel>
</rdf:Description>

