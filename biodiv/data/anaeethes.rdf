<rdf:Description rdf:about='http://opendata.inra.fr/anaeeThes/c3_2505'>
 <status:hasStatus rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>Published</status:hasStatus>
 <ns1:creator rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>demoadmin</ns1:creator>
 <rdf:type rdf:resource='http://www.w3.org/2004/02/skos/core#Concept'/>
 <skos:broader rdf:resource='http://opendata.inra.fr/anaeeThes/c2_2983'/>
 <skos:definition xml:lang='en'>the process by which plants transform carbon dioxide and water into carbohydrates and other compounds using energy from the sun captured by chlorophyll in the plant oxygen is a by product of the process photosynthesis is the essence of all plant life (autotrophic production) and hence of all animal life (heterotrophic production) on the planet earth the rate of photosynthesis depends on climate intensity and duration of sunlight available leaf area soil nutrient availability temperature carbon dioxide concentration and soil moisture regimes</skos:definition>
 <skos:exactMatch rdf:resource='http://www.eionet.europa.eu/gemet/concept/6211'/>
 <skos:exactMatch rdf:resource='http://aims.fao.org/aos/agrovoc/c_5812'/>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>photosynthesis</skos:prefLabel>
</rdf:Description>

