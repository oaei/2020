<rdf:Description rdf:about='http://opendata.inra.fr/anaeeThes/c2_2328'>
 <status:hasStatus rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>Published</status:hasStatus>
 <rdf:type rdf:resource='http://www.w3.org/2004/02/skos/core#Concept'/>
 <skos:altLabel xml:lang='en'>Ca</skos:altLabel>
 <skos:broader rdf:resource='http://opendata.inra.fr/anaeeThes/c2_2308'/>
 <skos:definition xml:lang='en'>a malleable silvery white metallic element of the alkaline hearth group the fifth most abundant element in the earth crust occurring especially as forms of calcium carbonate it is an essential constituent of bones and teeth and is used as a deoxidizer in steel</skos:definition>
 <skos:exactMatch rdf:resource='http://www.eionet.europa.eu/gemet/concept/1111'/>
 <skos:exactMatch rdf:resource='http://aims.fao.org/aos/agrovoc/c_1196'/>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>Calcium</skos:prefLabel>
 <skos:prefLabel xml:lang='fr'>Calcium</skos:prefLabel>
 <skos:scopeNote xml:lang='en'>unit:&#181;g/l</skos:scopeNote>
</rdf:Description>

