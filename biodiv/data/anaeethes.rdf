<rdf:Description rdf:about='http://ecoinformatics.org/oboe/oboe.1.0/oboe-standards.owl#Volt'>
 <rdf:type rdf:resource='http://www.w3.org/2004/02/skos/core#Concept'/>
 <skos:altLabel xml:lang='en'>V</skos:altLabel>
 <skos:broader rdf:resource='http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#CompositeUnit'/>
 <skos:definition xml:lang='en'>The volt is defined as the value of the voltage across a conductor when a current of one ampere dissipates one watt of power in the conductor.[2] It can be written in terms of SI base units as: m2 &#183; kg &#183; s&#8722;3 &#183; A&#8722;1. It is also equal to one joule of energy per coulomb of charge, J/C.</skos:definition>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>volt</skos:prefLabel>
 <skos:scopeNote rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>This concept has been imported from the AnaEE ontology Unit Branch classes</skos:scopeNote>
</rdf:Description>

