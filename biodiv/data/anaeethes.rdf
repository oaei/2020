<rdf:Description rdf:about='http://opendata.inra.fr/anaeeThes/c2_2509'>
 <status:hasStatus rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>Published</status:hasStatus>
 <ns1:modified rdf:datatype='http://www.w3.org/2001/XMLSchema#dateTime'>2017-03-13T08:25:05Z</ns1:modified>
 <rdf:type rdf:resource='http://www.w3.org/2004/02/skos/core#Concept'/>
 <skos:broader rdf:resource='http://opendata.inra.fr/anaeeThes/c2_2445'/>
 <skos:definition xml:lang='en'>A layer of organic material applied to the surface of the ground to retain moisture; mulching is the spreading of leaves, straw or other loose material on the ground to prevent erosion, evaporation or freezing of plant roots. (Source: GILP96)</skos:definition>
 <skos:exactMatch rdf:resource='http://www.eionet.europa.eu/gemet/concept/5418'/>
