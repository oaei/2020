<rdf:Description rdf:about='http://opendata.inra.fr/anaeeThes/c2_2460'>
 <status:hasStatus rdf:datatype='http://www.w3.org/2001/XMLSchema#string'>Published</status:hasStatus>
 <ns1:modified rdf:datatype='http://www.w3.org/2001/XMLSchema#dateTime'>2017-03-21T13:42:48Z</ns1:modified>
 <rdf:type rdf:resource='http://www.w3.org/2004/02/skos/core#Concept'/>
 <skos:broader rdf:resource='http://opendata.inra.fr/anaeeThes/c2_2445'/>
 <skos:definition xml:lang='en'>The average weather condition in a region of the world. Many aspects of the Earth&apos;s geography affect the climate. Equatorial, or low, latitudes are hotter than the polar latitudes because of the angle at which the rays of sunlight arrive at the Earth&apos;s surface. The difference in temperature at the equator and at the poles has an influence on the global circulation of huge masses of air. Cool air at the poles sinks and spreads along the surface of the Earth towards the equator. Cool air forces its way under the lower density warmer air in the lower regions, pushing the lighter air up and toward the poles, where it will cool and descend. (Source: WRIGHT)</skos:definition>
 <skos:exactMatch rdf:resource='http://www.eionet.europa.eu/gemet/concept/1462'/>
 <skos:exactMatch rdf:resource='http://aims.fao.org/aos/agrovoc/c_1665'/>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>climate</skos:prefLabel>
 <skos:prefLabel xml:lang='fr'>climat</skos:prefLabel>
</rdf:Description>

