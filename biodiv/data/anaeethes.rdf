 <skos:altLabel xml:lang='en'>N</skos:altLabel>
 <skos:broader rdf:resource='http://opendata.inra.fr/anaeeThes/c2_2308'/>
 <skos:definition xml:lang='en'>an essential nutrient in the food supply of plants and the diets of animals animals obtain it in nitrogen containing compounds particularly amino acids although the atmosphere is nearly 80 gaseous nitrogen very few organisms have the ability to use it in this form the higher plants normally obtain it from the soil after micro organisms have converted the nitrogen into ammonia or nitrates which they can then absorb</skos:definition>
 <skos:exactMatch rdf:resource='http://aims.fao.org/aos/agrovoc/c_5192'/>
 <skos:exactMatch rdf:resource='http://www.eionet.europa.eu/gemet/concept/5605'/>
 <skos:inScheme rdf:resource='http://opendata.inra.fr/anaeeThes/'/>
 <skos:prefLabel xml:lang='en'>Nitrogen</skos:prefLabel>
 <skos:prefLabel xml:lang='fr'>Azote</skos:prefLabel>
</rdf:Description>

