        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/SexRecord</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/isAdministrativePartOf -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/isAdministrativePartOf"/>
    


    <!-- https://enslaved.org/ontology/isDirectlyBasedOn -->

