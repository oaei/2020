    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasRaceRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasRaceRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasPersonRecord"/>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasSexRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasSexRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasPersonRecord"/>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasSpatialExtent -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasSpatialExtent"/>
    


    <!-- https://enslaved.org/ontology/hasStatusGeneratedEvent -->

