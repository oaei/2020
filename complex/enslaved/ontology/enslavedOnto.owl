    <!-- https://enslaved.org/ontology/hasBroader -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasBroader"/>
    


    <!-- https://enslaved.org/ontology/hasCoordinates -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasCoordinates">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasSpatialExtent"/>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Place</opla:isNativeTo>
    </owl:ObjectProperty>
    


