        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/InterAgentRelationshipRecord</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasLicenseInformation -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasLicenseInformation">
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/EntityWithProvenance</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasNameRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasNameRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasAgentRecord"/>
    </owl:ObjectProperty>
    


