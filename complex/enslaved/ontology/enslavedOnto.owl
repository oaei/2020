    <!-- https://enslaved.org/ontology/ProvenanceActivity -->

    <owl:Class rdf:about="https://enslaved.org/ontology/ProvenanceActivity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/performedBy"/>
