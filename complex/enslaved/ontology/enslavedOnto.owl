        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/PersonStatusRecord</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasTemporalExtent -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasTemporalExtent">
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/AgentRecord</opla:isNativeTo>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Event</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasValue -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasValue">
