    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasOccupationRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasOccupationRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasPersonRecord"/>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasOriginRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasOriginRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasPersonRecord"/>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasOriginalSourceType -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasOriginalSourceType">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://enslaved.org/ontology/isDirectlyBasedOn"/>
            <rdf:Description rdf:about="https://enslaved.org/ontology/hasOriginalSourceType"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://enslaved.org/ontology/isDirectlyBasedOn"/>
            </rdf:Description>
            <rdf:Description rdf:about="https://enslaved.org/ontology/hasOriginalSourceType"/>
        </owl:propertyChainAxiom>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/EntityWithProvenance</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasParticipantRoleRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasParticipantRoleRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasAgentRecord"/>
        <owl:inverseOf rdf:resource="https://enslaved.org/ontology/roleProvidedBy"/>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasParticipantRoleType -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasParticipantRoleType">
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/ParticipantRoleRecord</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasPersonRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasPersonRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasAgentRecord"/>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasPersonStatusRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasPersonStatusRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasPersonRecord"/>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasPlaceTypeCV -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasPlaceTypeCV">
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Place</opla:isNativeTo>
    </owl:ObjectProperty>
    


