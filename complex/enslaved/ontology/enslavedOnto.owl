    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasAgeRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasAgeRecord">
        <rdfs:subPropertyOf rdf:resource="https://enslaved.org/ontology/hasPersonRecord"/>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasAgentRecord -->

