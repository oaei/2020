        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Event</opla:isNativeTo>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Place</opla:isNativeTo>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/ResearchProject</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasECVO -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasECVO">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/OriginRecord</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasEventType -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasEventType">
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Event</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasExternalReference -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasExternalReference">
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Agent</opla:isNativeTo>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Event</opla:isNativeTo>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/ResearchProject</opla:isNativeTo>
    </owl:ObjectProperty>
    


    <!-- https://enslaved.org/ontology/hasInterAgentRelationshipRecord -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/hasInterAgentRelationshipRecord">
