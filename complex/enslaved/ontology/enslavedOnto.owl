    <!-- https://enslaved.org/ontology/TemporalExtent -->

    <owl:Class rdf:about="https://enslaved.org/ontology/TemporalExtent">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/fallsWithin"/>
                <owl:allValuesFrom rdf:resource="https://enslaved.org/ontology/TimeSpan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/contains"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/endsAt"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/occursAfter"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/occursBefore"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/startsAt"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/TemporalExtent</opla:isNativeTo>
    </owl:Class>
    


    <!-- https://enslaved.org/ontology/TimeSpan -->

    <owl:Class rdf:about="https://enslaved.org/ontology/TimeSpan">
        <rdfs:subClassOf rdf:resource="https://enslaved.org/ontology/TemporalExtent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/endsAt"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://enslaved.org/ontology/startsAt"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/TemporalExtent</opla:isNativeTo>
    </owl:Class>
    


