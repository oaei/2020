    <!-- https://enslaved.org/ontology/hasAlternateName -->

    <owl:DatatypeProperty rdf:about="https://enslaved.org/ontology/hasAlternateName">
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/Place</opla:isNativeTo>
    </owl:DatatypeProperty>
    


    <!-- https://enslaved.org/ontology/hasFirstNameAsString -->

