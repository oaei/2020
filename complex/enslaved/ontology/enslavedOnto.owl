    <!-- https://enslaved.org/ontology/reportsOn -->

    <owl:ObjectProperty rdf:about="https://enslaved.org/ontology/reportsOn">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://enslaved.org/ontology/agentRecordSelfProperty"/>
            <rdf:Description rdf:about="https://enslaved.org/ontology/recordedAt"/>
            <rdf:Description rdf:about="https://enslaved.org/ontology/eventSelfProperty"/>
        </owl:propertyChainAxiom>
        <opla:isNativeTo rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">https://enslaved.org/ontology/EntityWithProvenance</opla:isNativeTo>
    </owl:ObjectProperty>
    


