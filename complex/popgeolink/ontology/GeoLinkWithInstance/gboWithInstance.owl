        <IRI>#strongCoReferentOf</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Used to state that an instance matches with another based on a highly trusted machine-generated matching. The matching requires at least one additional corroborating piece of information that is trusted to differentiate individuals (e.g., surname and email match).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
