    <DataPropertyAssertion>
        <DataProperty IRI="#hasTitle"/>
        <NamedIndividual IRI="http://lod.bco-dmo.org/geolink/id/dataset-deployment/682093"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">Dataset: Zooplankton Densities from Cruise CB1005@en-us</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasAbstract"/>
        <NamedIndividual IRI="http://lod.bco-dmo.org/geolink/id/dataset-deployment/682107"/>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MOCNESS collections of invertebrate larvae throughout water column near methane seep sites: Barbados Accretionary Prism, 2012; Gulf of Mexico, 2014;Western Atlantic Margin, 2015 (SEEPC Project)&lt;br/&gt;&lt;p&gt;This dataset&amp;nbsp;is a collection log showing the preliminary identification of larval types and the final disposition of individual larval specimens from MOCNESS plankton samples.&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Related datasets:&lt;/strong&gt;&lt;br /&gt;
&lt;a href=&quot;http://www.bco-dmo.org/dataset/659965&quot; target=&quot;_blank&quot;&gt;SEEPC larval collections: SyPRID&lt;/a&gt;&lt;br /&gt;
&lt;a href=&quot;http://www.bco-dmo.org/dataset/659951&quot; target=&quot;_blank&quot;&gt;larval type codes&lt;/a&gt;&lt;br /&gt;
&lt;a href=&quot;https://www.bco-dmo.org/dataset/688111&quot; target=&quot;_blank&quot;&gt;SEEPC&lt;/a&gt;&lt;a href=&quot;https://www.bco-dmo.org/dataset/688111&quot; target=&quot;_blank&quot;&gt; Bivalve DNA Barcoding Results&lt;/a&gt;&lt;/p&gt;&lt;br/&gt;&lt;strong&gt;Acquisition Description:&lt;/strong&gt; &lt;p&gt;One-meter MOCNESSS nets fitted with 300 um mesh nets were towed obliquely over methane seep sites, closing and opening nets at intervals that varied with the depth. Upon recovery, all samples were sorted completely over the next 12 hours or less, picking all individual invertebrate larvae from the samples, assigning morphotypes, photographing with a microscope, and preserving either for Scanning Electron Microscopy (glutaraldehyde, 2012 only) or for molecular genetics (95% ETOH).&lt;/p&gt;&lt;br/&gt;&lt;strong&gt;Processing Description:&lt;/strong&gt; &lt;p&gt;This dataset&amp;nbsp;is a collection log showing the preliminary identification of larval types and the final disposition of individual larval specimens from MOCNESS plankton samples.&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Related datasets:&lt;/strong&gt;&lt;br /&gt;
&lt;a href=&quot;http://www.bco-dmo.org/dataset/659965&quot; target=&quot;_blank&quot;&gt;SEEPC larval collections: SyPRID&lt;/a&gt;&lt;br /&gt;
&lt;a href=&quot;http://www.bco-dmo.org/dataset/659951&quot; target=&quot;_blank&quot;&gt;larval type codes&lt;/a&gt;&lt;br /&gt;
&lt;a href=&quot;https://www.bco-dmo.org/dataset/688111&quot; target=&quot;_blank&quot;&gt;SEEPC&lt;/a&gt;&lt;a href=&quot;https://www.bco-dmo.org/dataset/688111&quot; target=&quot;_blank&quot;&gt; Bivalve DNA Barcoding Results&lt;/a&gt;&lt;/p&gt;&lt;br/&gt;</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasTitle"/>
        <NamedIndividual IRI="http://lod.bco-dmo.org/geolink/id/dataset-deployment/682107"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">Dataset: SEEPC larval collections: MOCNESS from Cruise EN531@en-us</Literal>
    </DataPropertyAssertion>
