    <DataPropertyAssertion>
        <DataProperty IRI="#hasAbstract"/>
        <NamedIndividual IRI="http://lod.bco-dmo.org/geolink/id/dataset-deployment/682628"/>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CTD profiles around the ALOHA observatory, HI and South Pacific Gyre&lt;br/&gt;&lt;p&gt;This dataset contains CTD profile data collected during R/V Kilo Moana cruises around the ALOHA observatory (KM1407, KM1418, and KM1604) and a cruise to the South Pacific Gyre (KM1515). &amp;nbsp;Date collected include pressure, depth, temperature, conductivity, salinity, dissolved oxygen, fluorescence, PAR, and turbidity.&lt;/p&gt;

&lt;pre&gt;
For more information about the ALOHA observatory see:&amp;nbsp;&lt;a href=&quot;http://aco-ssds.soest.hawaii.edu/&quot; target=&quot;_blank&quot;&gt;http://aco-ssds.soest.hawaii.edu/&lt;/a&gt;
&lt;/pre&gt;&lt;br/&gt;&lt;strong&gt;Acquisition Description:&lt;/strong&gt; &lt;p&gt;CTD data collected as per ship protocols.&lt;/p&gt;&lt;br/&gt;&lt;strong&gt;Processing Description:&lt;/strong&gt; &lt;p&gt;This dataset contains CTD profile data collected during R/V Kilo Moana cruises around the ALOHA observatory (KM1407, KM1418, and KM1604) and a cruise to the South Pacific Gyre (KM1515). &amp;nbsp;Date collected include pressure, depth, temperature, conductivity, salinity, dissolved oxygen, fluorescence, PAR, and turbidity.&lt;/p&gt;

&lt;pre&gt;
For more information about the ALOHA observatory see:&amp;nbsp;&lt;a href=&quot;http://aco-ssds.soest.hawaii.edu/&quot; target=&quot;_blank&quot;&gt;http://aco-ssds.soest.hawaii.edu/&lt;/a&gt;
&lt;/pre&gt;&lt;br/&gt;</Literal>
    </DataPropertyAssertion>
