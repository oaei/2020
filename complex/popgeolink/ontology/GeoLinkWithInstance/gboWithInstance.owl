        <NamedIndividual IRI="http://lod.bco-dmo.org/geolink/id/dataset-deployment/686550"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#string">Dataset: Scup and windowpane flounder length frequency counts from Cruise Elizabeth_and_Katherine-trip2@en-us</Literal>
