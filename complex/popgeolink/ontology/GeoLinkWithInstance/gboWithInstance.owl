    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasAbstract"/>
        <NamedIndividual IRI="http://lod.bco-dmo.org/geolink/id/dataset-deployment/682032"/>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CTD Profile Data from Lake Superior&lt;br/&gt;&lt;p&gt;This dataset contains&amp;nbsp;temperature, conductivity, dissolved oxygen, fluorescence, PAR, and salinity measured during CTD profile&amp;nbsp;downcasts in Lake Superior.&lt;/p&gt;&lt;br/&gt;&lt;strong&gt;Acquisition Description:&lt;/strong&gt; &lt;p&gt;CTD casts were conducted during R/V Blue Heron cruises at designated stations.&lt;/p&gt;&lt;br/&gt;&lt;strong&gt;Processing Description:&lt;/strong&gt; &lt;p&gt;This dataset contains&amp;nbsp;temperature, conductivity, dissolved oxygen, fluorescence, PAR, and salinity measured during CTD profile&amp;nbsp;downcasts in Lake Superior.&lt;/p&gt;&lt;br/&gt;</Literal>
