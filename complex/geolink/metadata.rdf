<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:seals="http://www.seals-project.eu/ontologies/SEALSMetadata.owl#"
    xmlns:dc="http://purl.org/dc/terms/">



    <!-- MATCHING PROBLEM -->
	
	<!-- gbo and gmo -->

	<rdf:Description rdf:about="http://www.seals-project.eu/alignment/GeoLinkSuiteTest">
		<rdf:type rdf:resource="http://www.seals-project.eu/ontologies/SEALSMetadata.owl#Suite"/>
		<seals:hasSuiteItem rdf:resource="http://www.seals-project.eu/alignment/GeoLinkSuiteTest#gbo-gmo"/>		
	</rdf:Description>

	<rdf:Description rdf:about="http://www.seals-project.eu/alignment/GeoLinkSuiteTest#gbo-gmo">
		<rdf:type rdf:resource="http://www.seals-project.eu/ontologies/SEALSMetadata.owl#SuiteItem"/>
		<seals:hasDataItem rdf:resource="http://www.seals-project.eu/alignment/GeoLinkSuiteTest#gbo"/>
		<seals:hasDataItem rdf:resource="http://www.seals-project.eu/alignment/GeoLinkSuiteTest#gmo"/>
		<seals:hasDataItem rdf:resource="http://www.seals-project.eu/alignment/GeoLinkSuiteTest#gbo-gmo-baseline"/>
		<dc:identifier>gbo-gmo</dc:identifier>
	</rdf:Description>


	<!-- ONTOLOGIES -->

	<!-- geoLink base ontology -->
	<rdf:Description rdf:about="http://www.seals-project.eu/alignment/GeoLinkSuiteTest#gbo">
		<rdf:type rdf:resource="http://www.seals-project.eu/ontologies/SEALSMetadata.owl#DataItem"/>
		<seals:hasComponentType>source</seals:hasComponentType>
		<seals:isLocatedAt>./ont/gbo.owl</seals:isLocatedAt>
		<dc:identifier>gbo</dc:identifier>
	</rdf:Description>

	<!-- geoLink modular ontology -->
	<rdf:Description rdf:about="http://www.seals-project.eu/alignment/GeoLinkSuiteTest#gmo">
		<rdf:type rdf:resource="http://www.seals-project.eu/ontologies/SEALSMetadata.owl#DataItem"/>
		<seals:hasComponentType>target</seals:hasComponentType>
		<seals:isLocatedAt>./ont/gmo.owl</seals:isLocatedAt>
		<dc:identifier>gmo</dc:identifier>
	</rdf:Description>
	
	<!-- Baseline reference -->
	<rdf:Description rdf:about="http://www.seals-project.eu/alignment/GeoLinkSuiteTest#gbo-gmo-baseline">
		<rdf:type rdf:resource="http://www.seals-project.eu/ontologies/SEALSMetadata.owl#DataItem"/>
		<seals:hasComponentType>reference</seals:hasComponentType>
		<seals:isLocatedAt>./ref/gbo-gmo.edoal</seals:isLocatedAt>
		<dc:identifier>gbo-gmo-baseline</dc:identifier>
	</rdf:Description> 	


</rdf:RDF>
